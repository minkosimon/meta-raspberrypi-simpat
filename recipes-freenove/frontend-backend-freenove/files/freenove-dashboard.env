FNK_FRONTEND_DIR=/opt/freenove/frontend
FNK_SCRIPTS_DIR=/opt/freenove/scripts
FNK_I2C_BUS=1
FNK_SSH_HOST=127.0.0.1
FNK_WS_HOST=0.0.0.0
FNK_WS_PORT=8080
FNK_WS_TLS=0
FNK_WS_TLS_CERT=/etc/ssl/freenove/freenove-dashboard.crt
FNK_WS_TLS_KEY=/etc/ssl/freenove/freenove-dashboard.key
FNK_WS_ALLOWED_ORIGINS=