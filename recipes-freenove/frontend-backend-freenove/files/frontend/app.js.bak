/* ===================================================================
 *  ULTRASONIC PANEL
 * =================================================================== */
function UltrasonicPanel({ ws, disabled }) {
  const [trig, setTrig]     = useState(23);
  const [echo, setEcho]     = useState(24);
  const [output, setOutput] = useState('');

  const read = async () => {
    setOutput('Mesure en cours...');
    const res = await ws.send('ultrasonic_read', { trig_pin: trig, echo_pin: echo });
    setOutput(JSON.stringify(res.data, null, 2));
  };

  return (
    <div className="card">
      <div className="card-header"><span className="icon">📏</span> Ultrason HC-SR04</div>
      <div className="card-body">
        <div className="field-row">
          <div className="field">
            <label>Trig</label>
            <input type="number" min="0" max="27" value={trig} onChange={e=>setTrig(+e.target.value)} />
          </div>
          <div className="field">
            <label>Echo</label>
            <input type="number" min="0" max="27" value={echo} onChange={e=>setEcho(+e.target.value)} />
          </div>
          <button className="btn" onClick={read} disabled={disabled}>Mesurer</button>
        </div>
        {output && <div className="output">{output}</div>}
      </div>
    </div>
  );
}

/* ===================================================================
 *  BUZZER PANEL
 * =================================================================== */
function BuzzerPanel({ ws, disabled }) {
  const [pin, setPin]   = useState(25);
  const [freq, setFreq] = useState(440);
  const [dur, setDur]   = useState(0.5);
  const [output, setOutput] = useState('');

  const tone = async () => {
    const res = await ws.send('buzzer', { pin, state:'tone', frequency:freq, duration:dur });
    setOutput(JSON.stringify(res.data, null, 2));
  };
  const off = async () => {
    const res = await ws.send('buzzer', { pin, state:'off' });
    setOutput(JSON.stringify(res.data, null, 2));
  };

  return (
    <div className="card">
      <div className="card-header"><span className="icon">🔔</span> Buzzer</div>
      <div className="card-body">
        <div className="field-row">
          <div className="field">
            <label>Pin</label>
            <input type="number" min="0" max="27" value={pin} onChange={e=>setPin(+e.target.value)} style={{width:70}} />
          </div>
          <div className="field">
            <label>Fréquence (Hz)</label>
            <input type="number" min="20" max="20000" value={freq} onChange={e=>setFreq(+e.target.value)} />
          </div>
          <div className="field">
            <label>Durée (s)</label>
            <input type="number" min="0.1" max="10" step="0.1" value={dur} onChange={e=>setDur(+e.target.value)} />
          </div>
        </div>
        <div style={{display:'flex',gap:8,marginTop:10}}>
          <button className="btn success" onClick={tone} disabled={disabled}>🔊 Jouer ton</button>
          <button className="btn danger" onClick={off} disabled={disabled}>🔇 Stop</button>
        </div>
        {output && <div className="output">{output}</div>}
      </div>
    </div>
  );
}

/* ===================================================================
 *  SYSTEM INFO PANEL
 * =================================================================== */
function SystemInfoPanel({ ws, disabled }) {
  const [info, setInfo]     = useState(null);
  const [output, setOutput] = useState('');

  const refresh = async () => {
    setOutput('Chargement...');
    const res = await ws.send('system_info');
    setOutput(JSON.stringify(res.data, null, 2));
    if (res.status === 'ok' && res.data.stdout) {
      try { setInfo(JSON.parse(res.data.stdout)); } catch {}
    }
  };

  const fmtUptime = (s) => {
    if (!s || s < 0) return '—';
    const h = Math.floor(s/3600);
    const m = Math.floor((s%3600)/60);
    return `${h}h ${m}m`;
  };

  return (
    <div className="card">
      <div className="card-header"><span className="icon">🖥️</span> Informations Système</div>
      <div className="card-body">
        <button className="btn" onClick={refresh} disabled={disabled} style={{marginBottom:10}}>
          Rafraîchir
        </button>
        {info && (
          <div className="sys-grid">
            <div className="sys-item">
              <div className="label">Hostname</div>
              <div className="value">{info.hostname}</div>
            </div>
            <div className="sys-item">
              <div className="label">Kernel</div>
              <div className="value" style={{fontSize:'.85rem'}}>{info.kernel}</div>
            </div>
            <div className="sys-item">
              <div className="label">CPU Temp</div>
              <div className="value" style={{color: info.cpu_temp_c > 70 ? '#ef4444' : '#22c55e'}}>
                {info.cpu_temp_c}°C
              </div>
            </div>
            <div className="sys-item">
              <div className="label">Uptime</div>
              <div className="value">{fmtUptime(info.uptime_s)}</div>
            </div>
            <div className="sys-item">
              <div className="label">Architecture</div>
              <div className="value">{info.arch}</div>
            </div>
            <div className="sys-item">
              <div className="label">Disque libre</div>
              <div className="value">{info.disk ? `${info.disk.free_mb} MB` : '—'}</div>
            </div>
          </div>
        )}
        {output && <div className="output">{output}</div>}
      </div>
    </div>
  );
}

/* ===================================================================
 *  TERMINAL PANEL
 * =================================================================== */
function TerminalPanel({ ws, disabled }) {
  const [cmd, setCmd]       = useState('');
  const [history, setHistory] = useState([]);

  const run = async () => {
    if (!cmd.trim()) return;
    setHistory(h => [...h, `$ ${cmd}`]);
    const res = await ws.send('run_command', { command: cmd });
    if (res.status === 'ok' && res.data) {
      if (res.data.stdout) setHistory(h => [...h, res.data.stdout]);
      if (res.data.stderr) setHistory(h => [...h, `[stderr] ${res.data.stderr}`]);
    } else {
      setHistory(h => [...h, `[error] ${res.message || JSON.stringify(res)}`]);
    }
    setCmd('');
  };

  return (
    <div className="card">
      <div className="card-header"><span className="icon">⌨️</span> Terminal SSH</div>
      <div className="card-body">
        <div className="output" style={{minHeight:120}}>
          {history.length === 0
            ? 'Entrez une commande à exécuter sur la carte...'
            : history.join('\n')}
        </div>
        <div className="terminal-input">
          <input value={cmd} onChange={e=>setCmd(e.target.value)}
            placeholder="Commande SSH..."
            onKeyDown={e => e.key === 'Enter' && !disabled && run()}
            disabled={disabled} />
          <button className="btn" onClick={run} disabled={disabled}>Exécuter</button>
        </div>
      </div>
    </div>
  );
}

/* ===================================================================
 *  MAIN APP
 * =================================================================== */
function App() {
  const wsUrl = `ws://${window.location.hostname}:${window.location.port || 8080}/ws`;
  const ws = useWebSocket(wsUrl);
  const [sshConnected, setSshConnected] = useState(false);
  const disabled = !ws.ready || !sshConnected;

  return (
    <div>
      <header className="app-header">
        <h1>🧪 Freenove <span>FNK0054</span> — Test Dashboard</h1>
        <ConnectionBar ws={ws} sshConnected={sshConnected} setSshConnected={setSshConnected} />
      </header>

      {!ws.ready && (
        <div style={{textAlign:'center',padding:40,color:'var(--text-dim)'}}>
          <p style={{fontSize:'1.2rem',marginBottom:12}}>⚡ Connexion au backend requise</p>
          <button className="btn" onClick={ws.connect}>Se connecter au WebSocket</button>
        </div>
      )}

      {ws.ready && !sshConnected && (
        <div style={{textAlign:'center',padding:20,color:'var(--orange)',fontSize:'.9rem'}}>
          ⚠️ Connectez-vous en SSH à la carte pour activer les contrôles
        </div>
      )}

      <main className="dashboard">
        <GpioPanel ws={ws} disabled={disabled} />
        <PwmPanel ws={ws} disabled={disabled} />
        <ServoPanel ws={ws} disabled={disabled} />
        <LedRgbPanel ws={ws} disabled={disabled} />
        <I2cPanel ws={ws} disabled={disabled} />
        <AdcPanel ws={ws} disabled={disabled} />
        <DhtPanel ws={ws} disabled={disabled} />
        <UltrasonicPanel ws={ws} disabled={disabled} />
        <BuzzerPanel ws={ws} disabled={disabled} />
        <SystemInfoPanel ws={ws} disabled={disabled} />
        <TerminalPanel ws={ws} disabled={disabled} />
      </main>
    </div>
  );
}

/* Mount */
const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(React.createElement(App));
